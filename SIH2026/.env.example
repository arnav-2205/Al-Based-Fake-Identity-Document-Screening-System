# ---- PostgreSQL ----
POSTGRES_DB=screening
POSTGRES_USER=screening
POSTGRES_PASSWORD=screening_pw

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=documents
MINIO_ENDPOINT=http://minio:9000

# ---- Backend ----
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/screening
SPRING_DATASOURCE_USERNAME=screening
SPRING_DATASOURCE_PASSWORD=screening_pw
JWT_SECRET=change-me-to-a-64-char-random-string-0123456789abcdef0123456789abcd
JWT_EXPIRATION_MS=3600000
AI_SERVICE_BASE_URL=http://ai-service:8000

# ---- Blockchain ----
FABRIC_ENABLED=false
FABRIC_GATEWAY_ENDPOINT=localhost:7051
FABRIC_CHANNEL=screeningchannel
FABRIC_CHAINCODE=verification

# ---- AI service ----
AI_USE_REAL_MODELS=false
